# Server-side only. Never commit a real API key.
OPENAI_API_KEY=

# Default model for governed support drafting.
OPENAI_MODEL=gpt-5.6

# Default model for semantic retrieval embeddings.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Bounded provider timeouts in milliseconds. Runtime clamps these to 1,000-15,000 ms.
AI_DRAFT_TIMEOUT_MS=8000
AI_EMBEDDING_TIMEOUT_MS=8000
